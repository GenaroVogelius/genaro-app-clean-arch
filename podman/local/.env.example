# Copy to podman/local/.env and adjust.

# DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO

# --- MongoDB -----------------------------------------------------------------
MONGODB_USER=admin
MONGODB_PASSWORD=password123
MONGODB_DATABASE=genaro-app-mongodb
# When running the API on the host (not in compose), point it to localhost:
# MONGODB_URL=mongodb://admin:password123@localhost:27017/genaro-app-mongodb?authSource=admin

# --- API ---------------------------------------------------------------------
ALLOW_ORIGINS=*

# Requests each client IP may make across the whole API (docs routes exempt),
# in slowapi notation, e.g. 10/minute or 100/hour. Over it, the API answers 429.
# Set RATE_LIMIT_ENABLED=False to turn it off, e.g. while load testing locally.
RATE_LIMIT=10/minute
RATE_LIMIT_ENABLED=True

# --- Auth --------------------------------------------------------------------
# API key authentication, on by default: every endpoint except
# /api/podcasts/health requires the header "X-API-Key: <API_KEY>".
# Set AUTH=False to disable it for local development.
AUTH=True
API_KEY=change-me

# --- Podcast export ----------------------------------------------------------
# Podcasts read from MongoDB per batch while streaming GET /api/podcasts/export.
# PODCAST_EXPORT_BATCH_SIZE=500
